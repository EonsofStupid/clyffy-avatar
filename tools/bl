#!/usr/bin/env python3
"""Send Python to the live Blender session and print what it answers.

    tools/bl 'result = len(bpy.data.objects["clyffy_mesh"].data.polygons)'
    echo 'result = ...' | tools/bl
    tools/bl -f some_script.py

Set `result` in the snippet and it comes back as JSON. Append to `out` for progress lines.
The session persists between calls — variables stay, the file stays open, no reload.
"""
import socket, sys, os, json

SOCK = os.environ.get("CLYFFY_BL_SOCK", "/tmp/clyffy_blender.sock")

if "-f" in sys.argv:
    code = open(sys.argv[sys.argv.index("-f") + 1]).read()
elif len(sys.argv) > 1:
    code = sys.argv[1]
else:
    code = sys.stdin.read()

if not os.path.exists(SOCK):
    sys.exit(f"no live Blender session at {SOCK} — start tools/blender_daemon.py first")

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(300)
s.connect(SOCK)
s.sendall(code.encode())
s.shutdown(socket.SHUT_WR)
buf = b""
while True:
    c = s.recv(65536)
    if not c:
        break
    buf += c
s.close()

try:
    r = json.loads(buf.decode())
except ValueError:
    print(buf.decode())
    sys.exit(1)

out = r.get("out")
if out:
    # the daemon does not always hand back a list here — be defensive rather
    # than crashing the wrapper on a response shape we did not expect
    if isinstance(out, (list, tuple)):
        for line in out:
            print(line)
    else:
        print(out)
if not r.get("ok"):
    print(r.get("error", "<error>"), file=sys.stderr)
    sys.exit(1)
res = r.get("result")
if res is not None:
    print(json.dumps(res, indent=2) if isinstance(res, (dict, list)) else res)
