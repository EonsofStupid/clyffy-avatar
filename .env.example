# Copy to .env and adjust. Every value has a default; placeholders only, never commit a real .env.

# ── compose ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=clyffy-avatar
# GPU: uncomment to always use the NVIDIA overlay (else CPU everywhere)
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
CLYFFY_IMAGE=clyffy-avatar:local
CLYFFY_RENDERER_IMAGE=clyffy-avatar-renderer:local

# ── renderer UI ──────────────────────────────────────────────────────────────
# 127.0.0.1 = this machine only; 0.0.0.0 to expose it on the LAN
CLYFFY_RENDERER_BIND=127.0.0.1
CLYFFY_RENDERER_PORT=5273

# ── render workers ───────────────────────────────────────────────────────────
# Cycles device without the GPU overlay: CPU | CUDA | OPTIX
CLYFFY_CYCLES_DEVICE=CPU
# Device the GPU overlay asks for, and how many GPUs it reserves
CLYFFY_GPU_DEVICE=CUDA
CLYFFY_GPU_COUNT=all
CLYFFY_RES=768x768
CLYFFY_SAMPLES=32
# CYCLES | BLENDER_EEVEE | BLENDER_WORKBENCH
CLYFFY_RENDER_ENGINE=CYCLES
CLYFFY_WORKER_POLL=2

# ── pinned build inputs (defaults = versions.env; override only to upgrade) ──
#BASE_IMAGE=docker.io/library/ubuntu:24.04@sha256:24737cef17f4e22b1977df7d9a05e77c4e28b7da5b8911f8d8ccda136bf3573c
#BLENDER_VERSION=5.2.0
#BLENDER_X64_SHA256=96f6c181a30f4950607839dc84d42a354b250d8a0231b098b59b7bc69c351c48

# ── install.sh (single-container path, Docker or Podman) ────────────────────
# docker | podman (auto-detected when empty)
CLYFFY_ENGINE=
# GPU for install.sh: auto | none | cdi | gpus
CLYFFY_GPU=auto
# Podman CDI device name (list them with: nvidia-ctk cdi list)
CLYFFY_CDI_DEVICE=nvidia.com/gpu=all

# ── optional ─────────────────────────────────────────────────────────────────
# rclone remote that holds the private canon art (archive/Clyffy_Avatar/pull-canon.sh). Example only.
REMOTE=your-rclone-remote
