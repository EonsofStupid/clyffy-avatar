# Line endings: LF everywhere, also on Windows clones (core.autocrlf=true would otherwise turn
# scripts, env files and the path allowlist CRLF inside the Linux images). Binaries are detected.
* text=auto eol=lf

# Git LFS — binary art and models
*.blend filter=lfs diff=lfs merge=lfs -text
*.vrm   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
