{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clyffy-avatar",
  "version": "0.1.0",
  "identifier": "ai.clyffy.avatar",
  "build": {
    "frontendDist": "../renderer/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "face",
        "title": "clyffy",
        "url": "index.html?transparent=1",
        "width": 420,
        "height": 560,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ]
  }
}